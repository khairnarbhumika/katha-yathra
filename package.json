{
  "name": "katha-yatra",
  "version": "1.0.0",
  "private": true,
  "description": "Katha Yatra - Cultural & Civilizational Gamified Learning Platform for Kids",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build && cd ../server && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}